@{ ViewData["Title"] = "AI Job Analyzer"; }
<div class="form-shell analyzer-shell"><div class="page-header"><div><p class="page-eyebrow">AI-assisted preparation</p><h1 class="page-title">Read between the lines of a job description.</h1><p class="page-subtitle">Get a structured view of the skills, technologies, experience, and recommendations a role emphasizes before you tailor your application.</p></div></div>@if (ViewBag.Error != null) { <div class="alert alert-danger" role="alert">@ViewBag.Error</div> }<section class="card analyzer-card"><div class="card-body"><div class="analyzer-intro"><span class="analysis-mark" aria-hidden="true">✦</span><div><h2 class="form-section-title mb-0">Role input</h2><p class="form-text mb-0">Paste the complete description for the clearest results.</p></div></div><form asp-controller="AI" asp-action="Analyze" method="post" data-analyzer-form>@Html.AntiForgeryToken()<label for="jobDescription" class="visually-hidden">Job description</label><textarea id="jobDescription" name="jobDescription" class="form-control analyzer-textarea" rows="14" maxlength="20000" placeholder="Paste the job description here...">@ViewBag.JobDescription</textarea><div class="analyzer-footer"><span class="input-count" data-input-count>0 characters</span><div class="form-actions"><button type="submit" class="btn btn-primary" data-analyze-button><span class="button-label">Analyze with AI</span><span class="button-loading" aria-hidden="true"><span class="spinner-border spinner-border-sm"></span> Analyzing…</span></button></div></div></form></div></section>@if (ViewBag.AnalysisHtml != null) { <section class="card analysis-card"><div class="card-header"><span class="analysis-mark" aria-hidden="true">✦</span><div><div class="analysis-heading-row"><h2 class="form-section-title mb-0">AI analysis</h2><span class="ai-generated-label">AI generated</span></div><p class="form-text mb-0">A structured reading of the role requirements.</p></div></div><div class="card-body"><div class="ai-analysis">@Html.Raw(ViewBag.AnalysisHtml)</div></div></section>}</div>
