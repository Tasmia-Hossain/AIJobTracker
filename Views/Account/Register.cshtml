@{ ViewData["Title"] = "Create account"; }
<div class="auth-page"><section class="card auth-card"><div class="card-body"><div class="auth-brand"><span class="brand-mark" aria-hidden="true">A</span>AIJobTracker</div><h1 class="auth-heading">Create your workspace</h1><p class="auth-copy">Start organizing your job search in one focused place.</p><form asp-action="Register" method="post"><div asp-validation-summary="All" class="validation-summary-errors mb-3"></div><div class="mb-3"><label for="email" class="form-label">Email address</label><input id="email" type="email" name="email" class="form-control" placeholder="you@example.com" autocomplete="email" required /></div><div class="mb-3"><label for="password" class="form-label">Password</label><input id="password" type="password" name="password" class="form-control" placeholder="Create a password" autocomplete="new-password" required /></div><button type="submit" class="btn btn-primary w-100">Create account</button></form><div class="auth-footer">Already have an account? <a asp-action="Login">Log in</a></div></div></section></div>
