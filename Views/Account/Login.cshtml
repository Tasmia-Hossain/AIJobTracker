@{ ViewData["Title"] = "Log in"; }
<div class="auth-page"><section class="card auth-card"><div class="card-body"><div class="auth-brand"><span class="brand-mark" aria-hidden="true">A</span>AIJobTracker</div><h1 class="auth-heading">Welcome back</h1><p class="auth-copy">Log in to continue tracking your applications.</p><form asp-action="Login" method="post"><div asp-validation-summary="All" class="validation-summary-errors mb-3"></div><div class="mb-3"><label for="email" class="form-label">Email address</label><input id="email" type="email" name="email" class="form-control" placeholder="you@example.com" autocomplete="email" required /></div><div class="mb-3"><label for="password" class="form-label">Password</label><input id="password" type="password" name="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" required /></div><button type="submit" class="btn btn-primary w-100">Log in</button></form><div class="auth-footer">New to AIJobTracker? <a asp-action="Register">Create an account</a></div></div></section></div>
