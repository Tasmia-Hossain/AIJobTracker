@{ ViewData["Title"] = "AIJobTracker"; }
<section class="home-hero"><div class="hero-content"><span class="hero-kicker"><span class="pulse-dot"></span> A focused job-search workspace</span><h1 class="hero-title">Turn job searching into a calmer, clearer process.</h1><p class="hero-copy">Track every opportunity, see your progress, and use AI to surface what each role is really asking for—all in one purposeful workspace.</p><div class="hero-actions">@if (User.Identity?.IsAuthenticated == true) { <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Open dashboard <span aria-hidden="true">→</span></a><a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-primary">View applications</a> } else { <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Start tracking jobs <span aria-hidden="true">→</span></a><a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Log in</a> }</div><div class="hero-proof"><span>✓ Free to use</span><span>✓ Your applications, organized</span><span>✓ AI-powered role analysis</span></div></div><aside class="hero-preview" aria-label="AIJobTracker features"><div class="preview-top"><span class="preview-label">Your focused workspace</span><span class="preview-illustration-label">Illustrative</span></div><div class="preview-rows"><div><span class="preview-company">⌁</span><p><strong>Track applications</strong><small>Keep every opportunity in context</small></p></div><div><span class="preview-company">◌</span><p><strong>See your pipeline</strong><small>Understand the status of your search</small></p></div><div><span class="preview-company">✦</span><p><strong>Prepare with AI</strong><small>Extract the signals that matter</small></p></div></div></aside></section>
<section class="section-intro"><p class="page-eyebrow">Built for your next move</p><h2>Everything you need to stay deliberate.</h2><p>Simple tools, arranged around the moments that matter in a job search.</p></section><section class="row g-3 g-lg-4"><div class="col-md-6 col-lg-3"><article class="card feature-card"><span class="feature-icon">⌁</span><span class="feature-number">TRACK</span><h2>One home for every role</h2><p>Keep the job, company, status, location, and applied date connected.</p></article></div><div class="col-md-6 col-lg-3"><article class="card feature-card"><span class="feature-icon">◌</span><span class="feature-number">PRIORITIZE</span><h2>See where to focus</h2><p>Use your dashboard to understand your pipeline at a glance.</p></article></div><div class="col-md-6 col-lg-3"><article class="card feature-card"><span class="feature-icon">✦</span><span class="feature-number">ANALYZE</span><h2>Read roles with AI</h2><p>Pull out skills, keywords, and recommendations from job descriptions.</p></article></div><div class="col-md-6 col-lg-3"><article class="card feature-card"><span class="feature-icon">↗</span><span class="feature-number">MOVE FORWARD</span><h2>Keep momentum visible</h2><p>Update each stage as you progress, without losing the bigger picture.</p></article></div></section>
<section class="home-showcase"><div class="showcase-copy"><p class="page-eyebrow">A clearer workflow</p><h2>From interesting role to prepared application.</h2><p>AIJobTracker keeps the process lightweight: capture an opportunity, keep its status current, and analyze the role before you apply.</p><a asp-controller="AI" asp-action="Analyze" class="text-link">Explore the AI Analyzer <span aria-hidden="true">→</span></a></div><div class="workflow-steps"><div><span>01</span><p><strong>Add an opportunity</strong><small>Save the essentials while they are fresh.</small></p></div><div><span>02</span><p><strong>Keep the stage current</strong><small>See your pipeline take shape over time.</small></p></div><div><span>03</span><p><strong>Prepare with AI</strong><small>Turn dense job descriptions into useful signals.</small></p></div></div></section>
<section class="home-cta"><div><p class="page-eyebrow">Ready when you are</p><h2>Make your next application your most intentional one.</h2></div>@if (User.Identity?.IsAuthenticated == true) { <a asp-controller="Jobs" asp-action="Create" class="btn btn-primary">Add a job application</a> } else { <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Create your free account</a> }</section>
