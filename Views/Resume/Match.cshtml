@model AIJobTracker.ViewModels.ResumeMatchViewModel

@{
    ViewData["Title"] = "Resume Matcher";
}

<div class="form-shell analyzer-shell">

    <div class="page-header">
        <div>
            <p class="page-eyebrow">AI-assisted application preparation</p>

            <h1 class="page-title">
                See how well your resume matches a job.
            </h1>

            <p class="page-subtitle">
                Compare your resume against one of your saved jobs
                to identify matches, skill gaps and preparation priorities.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger" role="alert">
            @Model.Error
        </div>
    }

    <section class="card analyzer-card">

        <div class="card-body">

            <div class="analyzer-intro">

                <span class="analysis-mark" aria-hidden="true">
                    ✦
                </span>

                <div>
                    <h2 class="form-section-title mb-0">
                        Match your resume
                    </h2>

                    <p class="form-text mb-0">
                        Select a saved job and paste your resume text.
                    </p>
                </div>

            </div>

            <form asp-controller="Resume"
                  asp-action="Match"
                  method="post"
                  data-resume-match-form>

                @Html.AntiForgeryToken()

                <div class="mb-4">

                    <label asp-for="JobId"
                           class="form-label fw-semibold">
                        Select Job
                    </label>

                    @if (Model.Jobs.Any())
                    {
                        <select asp-for="JobId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select a job --
                            </option>

                            @foreach (var job in Model.Jobs)
                            {
                                <option value="@job.Id">
                                    @job.Title — @job.Company
                                </option>
                            }

                        </select>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            You do not have any saved jobs yet.
                            Add a job first to use resume matching.
                        </div>
                    }

                </div>

                <div class="mb-4">

                    <label asp-for="ResumeText"
                           class="form-label fw-semibold">
                        Resume
                    </label>

                    <textarea asp-for="ResumeText"
                              class="form-control analyzer-textarea"
                              rows="16"
                              maxlength="20000"
                              placeholder="Paste your resume text here..."
                              required></textarea>

                    <div class="analyzer-footer">

                        <span class="input-count"
                              data-resume-count>
                            0 characters
                        </span>

                    </div>

                    <div class="form-text">
                        Include your education, skills, projects,
                        experience and technologies for a more useful comparison.
                    </div>

                </div>

                <div class="form-actions">

                    <button type="submit"
                            class="btn btn-primary"
                            data-match-button
                            disabled="@(!Model.Jobs.Any())">

                        <span class="button-label">
                            Match Resume with AI
                        </span>

                        <span class="button-loading"
                              aria-hidden="true">

                            <span class="spinner-border spinner-border-sm"></span>

                            Matching…

                        </span>

                    </button>

                </div>

            </form>

        </div>

    </section>

    @if (!string.IsNullOrWhiteSpace(Model.AnalysisHtml))
    {
        <section class="card analysis-card mt-4">

            <div class="card-header">

                <span class="analysis-mark"
                      aria-hidden="true">
                    ✦
                </span>

                <div>

                    <div class="analysis-heading-row">

                        <h2 class="form-section-title mb-0">
                            Resume match analysis
                        </h2>

                        <span class="ai-generated-label">
                            AI generated
                        </span>

                    </div>

                    <p class="form-text mb-0">
                        A comparison between your resume and the selected job.
                    </p>

                </div>

            </div>

            <div class="card-body">

                <div class="ai-analysis">
                    @Html.Raw(Model.AnalysisHtml)
                </div>

            </div>

        </section>
    }

</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.querySelector("[data-resume-match-form]");

            const textarea =
                document.getElementById("ResumeText");

            const counter =
                document.querySelector("[data-resume-count]");

            const button =
                document.querySelector("[data-match-button]");

            if (textarea && counter) {

                const updateCounter = () => {
                    counter.textContent =
                        `${textarea.value.length} characters`;
                };

                textarea.addEventListener(
                    "input",
                    updateCounter
                );

                updateCounter();
            }

            if (form && button) {

                form.addEventListener("submit", function () {

                    button.disabled = true;

                    const label =
                        button.querySelector(".button-label");

                    const loading =
                        button.querySelector(".button-loading");

                    if (label) {
                        label.style.display = "none";
                    }

                    if (loading) {
                        loading.style.display = "inline-flex";
                    }
                });
            }

        });
    </script>
}