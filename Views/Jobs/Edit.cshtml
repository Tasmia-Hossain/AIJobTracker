@model AIJobTracker.Models.Job
@{ ViewData["Title"] = "Edit Job"; }
<div class="form-shell"><div class="page-header"><div><p class="page-eyebrow">Application tracker</p><h1 class="page-title">Edit job application</h1><p class="page-subtitle">Update the details of this opportunity while keeping your tracker current.</p></div></div><section class="card form-card"><div class="card-body"><h2 class="form-section-title">Application details</h2><p class="form-section-copy">Make the changes you need, then save them to your tracker.</p><form asp-controller="Jobs" asp-action="Edit" method="post"><input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Title" class="form-label">Job title</label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title"></span></div><div class="col-md-6"><label asp-for="Company" class="form-label">Company</label><input asp-for="Company" class="form-control" /><span asp-validation-for="Company"></span></div><div class="col-md-6"><label asp-for="Location" class="form-label">Location</label><input asp-for="Location" class="form-control" /><span asp-validation-for="Location"></span></div><div class="col-md-6"><label asp-for="Status" class="form-label">Application status</label><select asp-for="Status" class="form-select"><option value="">Select status</option><option value="Saved">Saved</option><option value="Applied">Applied</option><option value="Interview">Interview</option><option value="Rejected">Rejected</option><option value="Offer">Offer</option><option value="Withdrawn">Withdrawn</option></select><span asp-validation-for="Status"></span></div><div class="col-md-6"><label asp-for="AppliedDate" class="form-label">Applied date</label><input asp-for="AppliedDate" type="date" class="form-control" /><span asp-validation-for="AppliedDate"></span></div></div><div class="form-actions"><button type="submit" class="btn btn-primary">Save changes</button><a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form></div></section></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
