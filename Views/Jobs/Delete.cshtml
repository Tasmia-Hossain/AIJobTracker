@model AIJobTracker.Models.Job

@{
    ViewData["Title"] = "Delete Job";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">Delete Job</h1>
        <p class="text-muted">
            Review the job information before deleting it.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="alert alert-warning">

                <h5 class="alert-heading fw-bold">
                    Are you sure you want to delete this job?
                </h5>

                <p class="mb-0">
                    This action cannot be undone.
                </p>

            </div>

            <div class="mt-4">

                <h3 class="fw-bold">
                    @Model.Title
                </h3>

                <hr />

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <h6 class="text-muted">
                            Company
                        </h6>

                        <p class="fw-semibold">
                            @Model.Company
                        </p>

                    </div>

                    <div class="col-md-6 mb-3">

                        <h6 class="text-muted">
                            Location
                        </h6>

                        <p class="fw-semibold">
                            @Model.Location
                        </p>

                    </div>

                    <div class="col-md-6 mb-3">

                        <h6 class="text-muted">
                            Application Status
                        </h6>

                        <p class="fw-semibold">
                            @Model.Status
                        </p>

                    </div>

                    <div class="col-md-6 mb-3">

                        <h6 class="text-muted">
                            Applied Date
                        </h6>

                        <p class="fw-semibold">
                            @Model.AppliedDate.ToShortDateString()
                        </p>

                    </div>

                </div>

            </div>

            <hr />

            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger me-2">
                    Yes, Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>