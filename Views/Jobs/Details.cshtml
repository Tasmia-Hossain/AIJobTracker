@model AIJobTracker.Models.Job

@{
    ViewData["Title"] = "Job Details";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1 class="fw-bold">Job Details</h1>
        <p class="text-muted">
            View the details of your job application.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-start mb-4">

                <div>
                    <h2 class="fw-bold mb-1">
                        @Model.Title
                    </h2>

                    <p class="text-muted mb-0">
                        @Model.Company
                    </p>
                </div>

                @if (Model.Status == "Applied")
                {
                    <span class="badge bg-primary fs-6">
                        Applied
                    </span>
                }
                else if (Model.Status == "Interview")
                {
                    <span class="badge bg-warning text-dark fs-6">
                        Interview
                    </span>
                }
                else if (Model.Status == "Offer")
                {
                    <span class="badge bg-success fs-6">
                        Offer
                    </span>
                }
                else if (Model.Status == "Rejected")
                {
                    <span class="badge bg-danger fs-6">
                        Rejected
                    </span>
                }
                else if (Model.Status == "Withdrawn")
                {
                    <span class="badge bg-secondary fs-6">
                        Withdrawn
                    </span>
                }
                else
                {
                    <span class="badge bg-info text-dark fs-6">
                        Saved
                    </span>
                }

            </div>

            <hr />

            <div class="row mt-4">

                <div class="col-md-6 mb-3">

                    <h6 class="text-muted">
                        Company
                    </h6>

                    <p class="fw-semibold">
                        @Model.Company
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <h6 class="text-muted">
                        Location
                    </h6>

                    <p class="fw-semibold">
                        @Model.Location
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <h6 class="text-muted">
                        Application Status
                    </h6>

                    <p class="fw-semibold">
                        @Model.Status
                    </p>

                </div>

                <div class="col-md-6 mb-3">

                    <h6 class="text-muted">
                        Applied Date
                    </h6>

                    <p class="fw-semibold">
                        @Model.AppliedDate.ToShortDateString()
                    </p>

                </div>

            </div>

            <div class="mt-4">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary me-2">
                    Edit Job
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger me-2">
                    Delete Job
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Jobs
                </a>

            </div>

        </div>

    </div>

</div>