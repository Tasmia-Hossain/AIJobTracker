@model AIJobTracker.Models.Job
@{ ViewData["Title"] = "Job Details"; }
<div class="page-header"><div><p class="page-eyebrow">Application tracker</p><h1 class="page-title">Application details</h1><p class="page-subtitle">A complete view of this job opportunity.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Back to jobs</a></div><section class="card detail-card"><div class="detail-hero"><div><h2 class="page-title">@Model.Title</h2><p class="detail-company">@Model.Company</p></div><span class="status-badge status-@Model.Status.ToLower()">@Model.Status</span></div><div class="detail-grid"><div class="detail-item"><span class="detail-label">Company</span><span class="detail-value">@Model.Company</span></div><div class="detail-item"><span class="detail-label">Location</span><span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Location) ? "Not specified" : Model.Location)</span></div><div class="detail-item"><span class="detail-label">Application status</span><span class="detail-value">@Model.Status</span></div><div class="detail-item"><span class="detail-label">Applied date</span><span class="detail-value">@Model.AppliedDate.ToString("MMMM d, yyyy")</span></div></div><div class="detail-actions"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit job</a><a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete job</a><a asp-action="Index" class="btn btn-outline-secondary">Back to jobs</a></div></section>
