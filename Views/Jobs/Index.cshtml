@model List<AIJobTracker.Models.Job>
@{ ViewData["Title"] = "My Jobs"; }
<div class="page-header"><div><p class="page-eyebrow">Application tracker</p><h1 class="page-title">My job applications</h1><p class="page-subtitle">Search, filter, and keep every opportunity moving.</p></div><a asp-controller="Jobs" asp-action="Create" class="btn btn-primary">Add new job</a></div>
<section class="card filter-card mb-4"><div class="card-body"><form asp-controller="Jobs" asp-action="Index" method="get"><div class="filter-heading"><span class="filter-icon">⌕</span><div><h2>Find an application</h2><p>Filter your tracker by keyword or application stage.</p></div></div><div class="row g-2 align-items-end"><div class="col-md-6"><label for="search" class="form-label">Search applications</label><input id="search" type="text" name="search" class="form-control" placeholder="Job title, company, or location" value="@Context.Request.Query["search"]" /></div><div class="col-md-4"><label for="status" class="form-label">Status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option>@foreach (var item in new[] { "Saved", "Applied", "Interview", "Rejected", "Offer", "Withdrawn" }) { <option value="@item" selected="@(Context.Request.Query["status"] == item)">@item</option> }</select></div><div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Apply filters</button></div></div></form></div></section>
@if (!Model.Any()) { <section class="card empty-state jobs-empty"><div class="empty-state-mark" aria-hidden="true">↗</div><span class="empty-state-label">Your application tracker</span><h2>@(Context.Request.Query["search"].Any() || Context.Request.Query["status"].Any() ? "No matching applications" : "Your next opportunity belongs here.")</h2><p>@(Context.Request.Query["search"].Any() || Context.Request.Query["status"].Any() ? "Try a different search or clear your filters to view all applications." : "Start with the role you are considering most. You can update its progress any time.")</p><div class="d-flex justify-content-center gap-2 flex-wrap">@if (Context.Request.Query["search"].Any() || Context.Request.Query["status"].Any()) { <a asp-action="Index" class="btn btn-outline-primary">Clear filters</a> }<a asp-action="Create" class="btn btn-primary">Add your first job</a></div></section> } else { <div class="list-context"><span>@Model.Count application@(Model.Count == 1 ? "" : "s") shown</span></div><section class="row g-3">@foreach (var job in Model) { <div class="col-md-6 col-xl-4"><article class="card job-card h-100"><div class="card-body"><div class="job-card-top"><span class="company-monogram" aria-hidden="true">@job.Company.Substring(0, 1).ToUpper()</span><span class="status-badge status-@job.Status.ToLower()">@job.Status</span></div><h2 class="job-card-title">@job.Title</h2><p class="job-company">@job.Company</p><div class="job-meta"><span><i aria-hidden="true">⌖</i> @(string.IsNullOrWhiteSpace(job.Location) ? "Location not specified" : job.Location)</span><span><i aria-hidden="true">◷</i> Applied @job.AppliedDate.ToString("MMM d, yyyy")</span></div><div class="card-actions"><a asp-action="Details" asp-route-id="@job.Id" class="btn btn-primary btn-sm">View details</a><a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-icon btn-sm" aria-label="Edit @job.Title" title="Edit application">✎</a><a asp-action="Delete" asp-route-id="@job.Id" class="btn btn-icon btn-danger-soft btn-sm" aria-label="Delete @job.Title" title="Delete application">×</a></div></div></article></div>}</section> }
