@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="form-shell"><div class="page-header"><div><p class="page-eyebrow">Something went wrong</p><h1 class="page-title">We couldn’t complete that request.</h1><p class="page-subtitle">Please try again. If the issue continues, use the request ID below when reporting it.</p></div></div><section class="card"><div class="card-body">@if (Model.ShowRequestId) { <p class="mb-0"><strong>Request ID:</strong> <code>@Model.RequestId</code></p> }</div></section></div>
