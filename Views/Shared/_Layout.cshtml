<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AIJobTracker</title>
    <script>try { document.documentElement.dataset.theme = localStorage.getItem('aijobtracker-theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch { }</script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contrast-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AIJobTracker.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light site-nav">
            <div class="container app-shell">
                <a class="navbar-brand brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">↗</span><span>AIJobTracker</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav nav-links me-auto">

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Jobs" ? "active" : "")"
                                   asp-controller="Jobs"
                                   asp-action="Index">
                                    Jobs
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AI" ? "active" : "")"
                                   asp-controller="AI"
                                   asp-action="Analyze">
                                    AI Analyzer
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Resume" ? "active" : "")"
                                   asp-controller="Resume"
                                   asp-action="Match">
                                    Resume Matcher
                                </a>
                            </li>
                        }

                    </ul>

                    <div class="nav-account">
                        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark mode" title="Switch theme">
                            <span class="theme-icon theme-icon-sun" aria-hidden="true">☀</span><span class="theme-icon theme-icon-moon" aria-hidden="true">☾</span>
                        </button>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="btn btn-primary btn-sm nav-primary-action" asp-controller="Jobs" asp-action="Create"><span aria-hidden="true">+</span> Add job</a>
                            <span class="user-chip"><span class="user-avatar" aria-hidden="true">@User.Identity.Name?.Substring(0, 1).ToUpper()</span><span class="user-name">@User.Identity.Name</span></span>
                            <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-link logout-button">Log out</button></form>
                        }
                        else
                        {
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-primary btn-sm nav-primary-action" asp-controller="Account" asp-action="Register">Register</a>
                        }

                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-shell">
        <main role="main" class="page-content">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container app-shell">
            <div><strong>AIJobTracker</strong><span class="footer-tagline">Your focused job-search workspace.</span></div><div class="footer-links"><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a><span>&copy; 2026</span></div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
