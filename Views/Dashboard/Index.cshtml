@model AIJobTracker.Models.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="page-header"><div><p class="page-eyebrow">Overview</p><h1 class="page-title">Your job search, at a glance</h1><p class="page-subtitle">A clear view of the applications you are actively managing.</p></div><a asp-controller="Jobs" asp-action="Create" class="btn btn-primary">Add job</a></div>
<section class="row g-3 dashboard-metrics"><div class="col-sm-6 col-xl-3"><article class="card metric-card accent"><span class="metric-icon">⌁</span><p class="metric-label">Total applications</p><p class="metric-value">@Model.TotalJobs</p><p class="metric-detail">Every opportunity in your tracker</p></article></div><div class="col-sm-6 col-xl-3"><article class="card metric-card"><span class="metric-icon metric-icon-blue">→</span><p class="metric-label">Applied</p><p class="metric-value">@Model.AppliedJobs</p><p class="metric-detail">Applications submitted</p></article></div><div class="col-sm-6 col-xl-3"><article class="card metric-card"><span class="metric-icon metric-icon-amber">◌</span><p class="metric-label">Interviews</p><p class="metric-value">@Model.InterviewJobs</p><p class="metric-detail">Conversations in progress</p></article></div><div class="col-sm-6 col-xl-3"><article class="card metric-card"><span class="metric-icon metric-icon-green">✦</span><p class="metric-label">Offers</p><p class="metric-value">@Model.OfferJobs</p><p class="metric-detail">Offers received</p></article></div></section>
<section class="row g-3 g-lg-4 mt-1"><div class="col-lg-7"><article class="card dashboard-overview"><div class="card-header"><div><h2 class="form-section-title mb-1">Application status</h2><p class="form-text mb-0">Your current search distribution.</p></div><span class="overview-total">@Model.TotalJobs total</span></div><div class="card-body">@if (Model.TotalJobs == 0) { <div class="dashboard-empty"><span class="empty-state-mark">↗</span><div><strong>Your pipeline starts here.</strong><p>Add an opportunity to see your application progress take shape.</p></div></div> } else { <div class="status-chart" aria-label="Application status distribution"><div class="chart-row"><span>Saved</span><div class="chart-track"><i class="chart-saved" style="width: @(Model.SavedJobs * 100 / Model.TotalJobs)%"></i></div><strong>@Model.SavedJobs</strong></div><div class="chart-row"><span>Applied</span><div class="chart-track"><i class="chart-applied" style="width: @(Model.AppliedJobs * 100 / Model.TotalJobs)%"></i></div><strong>@Model.AppliedJobs</strong></div><div class="chart-row"><span>Interview</span><div class="chart-track"><i class="chart-interview" style="width: @(Model.InterviewJobs * 100 / Model.TotalJobs)%"></i></div><strong>@Model.InterviewJobs</strong></div><div class="chart-row"><span>Offer</span><div class="chart-track"><i class="chart-offer" style="width: @(Model.OfferJobs * 100 / Model.TotalJobs)%"></i></div><strong>@Model.OfferJobs</strong></div><div class="chart-row"><span>Closed</span><div class="chart-track"><i class="chart-closed" style="width: @((Model.RejectedJobs + Model.WithdrawnJobs) * 100 / Model.TotalJobs)%"></i></div><strong>@(Model.RejectedJobs + Model.WithdrawnJobs)</strong></div></div> }</div></article></div><div class="col-lg-5"><article class="card quick-actions-card"><div class="card-header"><h2 class="form-section-title mb-0">Quick actions</h2></div><div class="card-body"><a asp-controller="Jobs" asp-action="Create" class="quick-action"><span class="quick-action-icon">+</span><span><strong>Add an application</strong><small>Capture a new opportunity</small></span><b aria-hidden="true">→</b></a><a asp-controller="Jobs" asp-action="Index" class="quick-action"><span class="quick-action-icon">⌁</span><span><strong>Review your tracker</strong><small>Search and update roles</small></span><b aria-hidden="true">→</b></a><a asp-controller="AI" asp-action="Analyze" class="quick-action"><span class="quick-action-icon">✦</span><span><strong>Analyze a role</strong><small>Unpack a job description</small></span><b aria-hidden="true">→</b></a></div></article></div></section>
<section class="card dashboard-momentum mt-4"><div><p class="page-eyebrow">Next best step</p><h2>@(Model.InterviewJobs > 0 ? "You have interview momentum—keep preparation focused." : "Keep your next opportunity moving.")</h2><p>Small, consistent updates make your job search easier to manage and easier to learn from.</p></div><a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-primary">View all applications</a></section>
