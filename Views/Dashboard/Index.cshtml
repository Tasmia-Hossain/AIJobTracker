@model AIJobTracker.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <p class="page-eyebrow">Application tracker</p>

        <h1 class="page-title">
            Dashboard
        </h1>

        <p class="page-subtitle">
            See your job search progress at a glance.
        </p>
    </div>

    <a asp-controller="Jobs"
       asp-action="Create"
       class="btn btn-primary">
        Add new job
    </a>
</div>

<!-- Main statistics -->

<section class="row g-3 mb-4">

    <div class="col-6 col-lg-3">
        <div class="card dashboard-stat-card h-100">
            <div class="card-body">
                <span class="stat-label">Total applications</span>
                <h2 class="stat-value">
                    @Model.TotalApplications
                </h2>
                <span class="stat-description">
                    All tracked opportunities
                </span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card dashboard-stat-card h-100">
            <div class="card-body">
                <span class="stat-label">Applied</span>
                <h2 class="stat-value">
                    @Model.AppliedApplications
                </h2>
                <span class="stat-description">
                    Applications submitted
                </span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card dashboard-stat-card h-100">
            <div class="card-body">
                <span class="stat-label">Interviews</span>
                <h2 class="stat-value">
                    @Model.InterviewApplications
                </h2>
                <span class="stat-description">
                    Interview-stage applications
                </span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card dashboard-stat-card h-100">
            <div class="card-body">
                <span class="stat-label">Offers</span>
                <h2 class="stat-value">
                    @Model.OfferApplications
                </h2>
                <span class="stat-description">
                    Successful outcomes
                </span>
            </div>
        </div>
    </div>

</section>

<!-- Conversion analytics -->

<section class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="card dashboard-analytics-card h-100">
            <div class="card-body">
                <span class="stat-label">
                    Application rate
                </span>

                <h2 class="stat-value">
                    @Model.ApplicationRate%
                </h2>

                <p class="text-muted mb-0">
                    Jobs that reached the Applied stage.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card dashboard-analytics-card h-100">
            <div class="card-body">
                <span class="stat-label">
                    Interview rate
                </span>

                <h2 class="stat-value">
                    @Model.InterviewRate%
                </h2>

                <p class="text-muted mb-0">
                    Total applications that reached Interview.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card dashboard-analytics-card h-100">
            <div class="card-body">
                <span class="stat-label">
                    Offer rate
                </span>

                <h2 class="stat-value">
                    @Model.OfferRate%
                </h2>

                <p class="text-muted mb-0">
                    Total applications that reached Offer.
                </p>
            </div>
        </div>
    </div>

</section>

<!-- Status overview -->

<section class="card mb-4">

    <div class="card-body">

        <div class="section-heading">
            <div>
                <h2>Application pipeline</h2>
                <p>
                    Current distribution of your applications.
                </p>
            </div>
        </div>

        <div class="row g-3">

            <div class="col-6 col-md-4 col-lg-2">
                <div class="pipeline-item">
                    <span>Saved</span>
                    <strong>@Model.SavedApplications</strong>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-2">
                <div class="pipeline-item">
                    <span>Applied</span>
                    <strong>@Model.AppliedApplications</strong>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-2">
                <div class="pipeline-item">
                    <span>Interview</span>
                    <strong>@Model.InterviewApplications</strong>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-2">
                <div class="pipeline-item">
                    <span>Offer</span>
                    <strong>@Model.OfferApplications</strong>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-2">
                <div class="pipeline-item">
                    <span>Rejected</span>
                    <strong>@Model.RejectedApplications</strong>
                </div>
            </div>

            <div class="col-6 col-md-4 col-lg-2">
                <div class="pipeline-item">
                    <span>Withdrawn</span>
                    <strong>@Model.WithdrawnApplications</strong>
                </div>
            </div>

        </div>

    </div>

</section>

<!-- Monthly activity -->
@if (Model.MonthlyApplications.Any())
{
    <section class="card mb-4">

        <div class="card-body">

            <div class="section-heading">
                <div>
                    <h2>Application activity</h2>
                    <p>
                        Applications added over the recent months.
                    </p>
                </div>
            </div>

            <div class="activity-chart">

                @{
                    var maxCount = Model.MonthlyApplications
                        .Max(x => x.Count);

                    if (maxCount == 0)
                    {
                        maxCount = 1;
                    }
                }

                @foreach (var item in Model.MonthlyApplications)
                {
                    var height = Math.Max(
                        12,
                        (int)((double)item.Count / maxCount * 180));

                    <div class="activity-bar-column">

                        <span class="activity-count">
                            @item.Count
                        </span>

                        <div class="activity-bar"
                             style="height:@($"{height}px")">
                        </div>

                        <span class="activity-label">
                            @item.Month
                        </span>

                    </div>
                }

            </div>

        </div>

    </section>
}

<!-- Recent applications + deadlines -->

<section class="row g-3">

    <div class="col-lg-7">

        <section class="card h-100">

            <div class="card-body">

                <div class="section-heading">
                    <div>
                        <h2>Recent applications</h2>
                        <p>
                            Your latest tracked opportunities.
                        </p>
                    </div>

                    <a asp-controller="Jobs"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-secondary">
                        View all
                    </a>
                </div>

                @if (!Model.RecentApplications.Any())
                {
                    <div class="empty-state py-5">
                        <h3>No applications yet</h3>

                        <p>
                            Add your first job application to start
                            building your dashboard.
                        </p>

                        <a asp-controller="Jobs"
                           asp-action="Create"
                           class="btn btn-primary">
                            Add job
                        </a>
                    </div>
                }
                else
                {
                    <div class="dashboard-job-list">

                        @foreach (var job in Model.RecentApplications)
                        {
                            <div class="dashboard-job-item">

                                <div>
                                    <strong>
                                        @job.Title
                                    </strong>

                                    <span>
                                        @job.Company
                                    </span>
                                </div>

                                <div class="text-end">

                                    <span class="status-badge status-@job.Status.ToLower()">
                                        @job.Status
                                    </span>

                                    <small class="d-block text-muted mt-1">
                                        @job.AppliedDate.ToString("MMM d, yyyy")
                                    </small>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </section>

    </div>

    <div class="col-lg-5">

        <section class="card h-100">

            <div class="card-body">

                <div class="section-heading">
                    <div>
                        <h2>Upcoming deadlines</h2>
                        <p>
                            Application deadlines you should keep in mind.
                        </p>
                    </div>
                </div>

                @if (!Model.UpcomingDeadlines.Any())
                {
                    <div class="empty-state py-5">
                        <h3>No upcoming deadlines</h3>

                        <p>
                            Add deadlines to your applications to keep
                            important opportunities visible.
                        </p>
                    </div>
                }
                else
                {
                    <div class="dashboard-job-list">

                        @foreach (var job in Model.UpcomingDeadlines)
                        {
                            <div class="dashboard-job-item">

                                <div>
                                    <strong>
                                        @job.Title
                                    </strong>

                                    <span>
                                        @job.Company
                                    </span>
                                </div>

                                <div class="text-end">

                                    <strong>
                                        @job.Deadline?.ToString("MMM d")
                                    </strong>

                                    <small class="d-block text-muted">
                                        Deadline
                                    </small>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </section>

    </div>

</section>