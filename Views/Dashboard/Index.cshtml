@model AIJobTracker.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <!-- Dashboard Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">Job Application Dashboard</h1>

            <p class="text-muted mb-0">
                Track and manage your job application progress.
            </p>
        </div>

        <a asp-controller="Jobs"
           asp-action="Create"
           class="btn btn-primary">
            + Add Job
        </a>

    </div>


    <!-- Statistics Cards -->

    <div class="row g-4">

        <!-- Total -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Jobs
                    </h6>

                    <h2 class="fw-bold">
                        @Model.TotalJobs
                    </h2>

                    <p class="text-muted mb-0">
                        All tracked applications
                    </p>

                </div>

            </div>

        </div>


        <!-- Saved -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Saved
                    </h6>

                    <h2 class="fw-bold">
                        @Model.SavedJobs
                    </h2>

                    <p class="text-muted mb-0">
                        Jobs you plan to apply for
                    </p>

                </div>

            </div>

        </div>


        <!-- Applied -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Applied
                    </h6>

                    <h2 class="fw-bold">
                        @Model.AppliedJobs
                    </h2>

                    <p class="text-muted mb-0">
                        Applications submitted
                    </p>

                </div>

            </div>

        </div>


        <!-- Interview -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Interviews
                    </h6>

                    <h2 class="fw-bold">
                        @Model.InterviewJobs
                    </h2>

                    <p class="text-muted mb-0">
                        Interview opportunities
                    </p>

                </div>

            </div>

        </div>


        <!-- Offers -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Offers
                    </h6>

                    <h2 class="fw-bold">
                        @Model.OfferJobs
                    </h2>

                    <p class="text-muted mb-0">
                        Job offers received
                    </p>

                </div>

            </div>

        </div>


        <!-- Rejected -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Rejected
                    </h6>

                    <h2 class="fw-bold">
                        @Model.RejectedJobs
                    </h2>

                    <p class="text-muted mb-0">
                        Applications rejected
                    </p>

                </div>

            </div>

        </div>


        <!-- Withdrawn -->

        <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <h6 class="text-muted">
                        Withdrawn
                    </h6>

                    <h2 class="fw-bold">
                        @Model.WithdrawnJobs
                    </h2>

                    <p class="text-muted mb-0">
                        Applications withdrawn
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Quick Actions -->

    <div class="card shadow-sm border-0 mt-5">

        <div class="card-body">

            <h5 class="fw-bold">
                Quick Actions
            </h5>

            <p class="text-muted">
                Manage your job applications quickly.
            </p>

            <a asp-controller="Jobs"
               asp-action="Index"
               class="btn btn-outline-primary me-2">
                View All Jobs
            </a>

            <a asp-controller="Jobs"
               asp-action="Create"
               class="btn btn-primary">
                Add New Job
            </a>

        </div>

    </div>

</div>